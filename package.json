{
  "name": "loung-prototype-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "node --use-system-ca node_modules/next/dist/bin/next build",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "node --use-system-ca --env-file-if-exists=.env.local --env-file-if-exists=.env.test.local --import tsx --test tests/integration/*.test.ts",
    "test:http": "tsx --test tests/http/*.test.ts",
    "auth:check": "node --use-system-ca --env-file-if-exists=.env.local --import tsx scripts/check-auth.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.548.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
